name: NAXA quality
on:
  workflow_dispatch:
  push:
    branches: [main, rewrite/naxa-from-main-20261007]
  pull_request:
    branches: [main, consolidation]
jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm install --no-audit --no-fund
      - run: npx tsc --noEmit
      - run: npm run lint
      - run: npm run build
        env:
          NEXT_PUBLIC_SUPABASE_URL: https://build-test.supabase.co
          NEXT_PUBLIC_SUPABASE_ANON_KEY: build-test-anon-key
          SUPABASE_SERVICE_ROLE_KEY: build-test-service-role-key
  architecture-supabase:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: supabase/setup-cli@v1
        with:
          version: latest
      - name: Configurer Supabase local
        run: |
          cat > supabase/config.toml <<'EOF'
          project_id = "naxa-architecture-ci"
          [api]
          enabled = true
          [db]
          major_version = 17
          [studio]
          enabled = false
          [inbucket]
          enabled = false
          [storage]
          enabled = false
          [realtime]
          enabled = false
          [analytics]
          enabled = false
          [edge_runtime]
          enabled = false
          EOF
      - name: Préparer les migrations
        run: |
          rm -rf supabase/migrations
          mkdir -p supabase/migrations
          cp supabase/schema.sql supabase/migrations/20261006000000_base.sql
          n=1
          for f in supabase/migration_*.sql; do
            ts=$(printf '2026100600%02d' "$n")
            cp "$f" "supabase/migrations/$ts-$(basename "$f")"
            n=$((n+1))
          done
      - name: Démarrer Supabase local
        run: supabase start
      - name: Replay complet
        run: supabase db reset
      - name: Assertions architecture
        run: supabase db query --file supabase/tests/028_promoteur_responsable_accreditation.sql
      - name: Tests comportementaux architecture
        run: supabase db query --file supabase/tests/028_promoteur_responsable_accreditation_behavior.sql
      - name: Arrêt Supabase
        if: always()
        run: supabase stop
