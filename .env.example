NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
# Serveur uniquement. Secret API key propre à chaque environnement.
# En Preview/Development, utiliser exclusivement une clé sb_secret_ dédiée au projet Supabase Replay.
# Ne jamais copier la clé Production dans Replay, Preview, Development ou les tests.
SUPABASE_SECRET_KEY=xxxx
# IA gratuite (brouillons de fiches produits, serveur uniquement, équipe NAXA seulement). Clé : aistudio.google.com
GEMINI_API_KEY=xxxx
# Facultatif : nom du modèle gratuit (vérifier le nom actuel dans Google AI Studio)
IA_MODELE=gemini-2.5-flash
